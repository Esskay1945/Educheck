# Set AI_PROVIDER to groq, xai, or openai. Without a key, Sentinel uses local style checks.
# AI_PROVIDER=groq
# GROQ_API_KEY=
# XAI_API_KEY=
# OPENAI_API_KEY=
# Optional model override for the selected provider
# GROQ_MODEL=openai/gpt-oss-120b
# XAI_MODEL=grok-4.3
# OPENAI_MODEL=gpt-4.1-mini
# AI_MODEL=

# Required when using the Procfile or Docker. Use a long, random password.
# EDUCHECK_ACCESS_TOKEN=
# Stable secret to keep audit tokens valid across restarts and replicas.
# EDUCHECK_SECRET_KEY=
# EDUCHECK_RATE_LIMIT=12
# EDUCHECK_GLOBAL_RATE_LIMIT=36
# EDUCHECK_PROXY_HOPS=0
# EDUCHECK_OCR_LANG=eng
